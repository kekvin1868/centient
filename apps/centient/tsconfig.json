{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["es2023"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src", "../../packages/*/src"],
  "exclude": ["../../packages/*/src/*.test.ts"]
}
