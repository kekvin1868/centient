{
  "name": "centient",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p apps/centient && tsc --noEmit -p apps/centient/client",
    "dev": "npm run dev -w apps/centient",
    "phone": "npm run phone -w apps/centient",
    "deploy": "npm run deploy -w apps/centient",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "perf": "node scripts/perf.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "1.63.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
